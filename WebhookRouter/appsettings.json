{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": "localhost:6379,abortConnect=false"
  },
  "HyperPay": {
    "WebhookSecretEnabled": false,
    "WebhookSecret": "",
    "IdentifierParameter": "SHOPPER_service"
  },
  "Routing": {
    "DefaultUrl": "https://api.roa.prod.hostinger.bitscollision.net/v1/Payments/HyperPay/Webhook",
    "TimeoutSeconds": 30,
    "Services": [
      {
        "Identifier": "menna-qa",
        "Url": "https://api.roa.hostinger.bitscollision.net/v1/Payments/HyperPay/Webhook"
      },
      {
        "Identifier": "menna",
        "Url": "https://api.roa.prod.hostinger.bitscollision.net/v1/Payments/HyperPay/Webhook"
      }
    ]
  },
  "Hangfire": {
    "RedisPrefix": "webhookrouter:hangfire:",
    "WorkerCount": 4,
    "RetryAttempts": 10,
    "RetryDelaysInSeconds": [ 10, 30, 60, 120, 300, 600, 1800, 3600, 7200, 14400 ],
    "SchedulePollingSeconds": 5,
    "DashboardEnabled": false
  }
}
